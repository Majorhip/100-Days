{
  "name": "stranded",
  "version": "0.0.0",
  "private": true,
  "description": "Stranded: 100 Days on Kestrel Island",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vite build && vitest run",
    "check": "vite build && vitest run tests/survival.test.js tests/time.test.js tests/scout-story.test.js && node tests/golden/parity.mjs dist/index.html --quick",
    "smoke": "node tests/smoke.mjs",
    "golden:fingerprint": "node tests/golden/fingerprint.mjs",
    "golden:save": "node tests/golden/savecheck.mjs",
    "golden:shots": "node tests/golden/screenshots.mjs",
    "golden:newgame": "node tests/golden/newgame.mjs",
    "golden:touch": "node tests/golden/touchcheck.mjs",
    "golden:build": "node tests/golden/compare-build.mjs",
    "parity": "vite build && node tests/golden/parity.mjs dist/index.html --shots",
    "ship": "vite build && node tools/ship.mjs && node tests/golden/ship.mjs"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "acorn": "^8.19.0",
    "eslint-scope": "^9.1.2",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^25.18.1",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "three": "0.128.0"
  }
}
